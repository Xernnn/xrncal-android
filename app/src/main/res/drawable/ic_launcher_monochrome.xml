<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher icon monochrome layer (themed icons): the foreground's glyph in one colour, with the
     square as a hole, because the system tints whatever is opaque. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group android:translateX="18" android:translateY="18"
        android:scaleX="0.72" android:scaleY="0.72">
        <group android:translateX="-2.5" android:translateY="-2.5"
            android:scaleX="1.05" android:scaleY="1.05">
            <path
                android:pathData="@string/tile_glyph"
                android:fillColor="#FFFFFF"
                android:fillType="evenOdd" />
        </group>
    </group>
</vector>
