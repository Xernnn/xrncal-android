<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher icon foreground: the calendar glyph, centred in the tile.
     The square is painted in the tile's colour, so the swoosh behind doesn't show through. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group android:translateX="18" android:translateY="18"
        android:scaleX="0.72" android:scaleY="0.72">
        <group android:translateX="-2.5" android:translateY="-2.5"
            android:scaleX="1.05" android:scaleY="1.05">
            <path android:pathData="@string/tile_glyph_page" android:fillColor="#FFFFFF" />
            <path android:pathData="@string/tile_glyph_cuts" android:fillColor="@color/xrn_tile" />
        </group>
    </group>
</vector>
