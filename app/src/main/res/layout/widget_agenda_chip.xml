<?xml version="1.0" encoding="utf-8"?>
<!-- An event in the agenda widget: a chip of its calendar's colour holding a dot of it, its title,
     and its time and place. The chip sits in a frame because a nested RemoteViews' tap goes to a
     view inside it: on its root the framework only tags the fill-in, for a list item's own tap. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    tools:ignore="UselessParent">

    <LinearLayout
        android:id="@+id/chip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_chip"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="6dp"
        android:paddingEnd="10dp"
        android:paddingBottom="6dp">

        <!-- The dot is its own view, tinted to the calendar's colour, rather than a compound drawable. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            tools:ignore="UseCompoundDrawables">

            <ImageView
                android:id="@+id/chip_color"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_dot" />

            <TextView
                android:id="@+id/chip_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textFontWeight="600"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/chip_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:layout_marginStart="13dp"
            android:textSize="11sp" />
    </LinearLayout>
</FrameLayout>
